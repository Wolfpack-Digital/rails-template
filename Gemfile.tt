source 'https://rubygems.org'
git_source(:github) { |repo| "https://github.com/#{repo}.git" }

ruby '<%= RUBY_VERSION %>'

# Core
gem 'bootsnap', '>= 1.7.5', require: false
gem 'pg'<%= gemfile_requirement('pg') %>
gem 'puma'<%= gemfile_requirement('puma') %>
gem 'rack-cors'
gem 'rails', '~> <%= Rails.version %>'

<% if gemfile_requirement('propshaft') -%>
  gem 'propshaft'
<% end -%>
<% if gemfile_requirement('turbo-rails') -%>
  gem 'turbo-rails'<%= gemfile_requirement('turbo-rails') %>
<% end -%>
<% if gemfile_requirement('stimulus-rails') -%>
  gem 'stimulus-rails'<%= gemfile_requirement('stimulus-rails') %>
<% end -%>
<% if gemfile_requirement('jbuilder') -%>
  gem 'jbuilder'<%= gemfile_requirement('jbuilder') %>
<% end -%>
<% if gemfile_requirement('importmap-rails') -%>
  gem 'importmap-rails'<%= gemfile_requirement('importmap-rails')%>
<% end-%>

<% if gemfile_requirement('kamal')  -%>
  gem 'kamal'
<% end-%>

<% if gemfile_requirement('solid_queue')  -%>
  gem 'solid_queue'
<% end-%>

<% if gemfile_requirement('solid_cache')  -%>
  gem 'solid_cache'
<% end-%>

<% if gemfile_requirement('solid_cable')  -%>
  gem 'solid_cable'
<% end-%>

# Configuration
gem 'dotenv-rails'

# Serialization
gem 'alba'
gem 'oj'

# Documentation
gem 'apipie-rails'

# Use Active Storage variants [https://guides.rubyonrails.org/active_storage_overview.html#transforming-images]
# gem 'image_processing'
gem 'net-http'

# If you are using the sentry error logging
# Logging
# gem 'sentry-ruby'
# gem 'sentry-rails'

group :development do
  gem 'amazing_print'
  gem "annotaterb"
  gem 'better_errors'
  gem 'brakeman', require: false
  gem 'bundler-audit', require: false
  gem 'letter_opener'
  gem 'listen'<%= gemfile_requirement('listen') %>
  gem 'overcommit', require: false
  gem 'rails-erd'
  gem 'rubocop', require: false
end

group :development, :test do
  gem 'bullet'
  gem 'byebug'
  gem 'database_cleaner'
  gem 'dox', '~> 2.1', require: false
  gem 'factory_bot_rails'
  gem 'faker'
  gem 'rspec-rails'
  gem 'shoulda-matchers'
  gem 'simplecov', require: false
  gem 'vcr'
end

group :test do
  gem 'shoulda'
end
